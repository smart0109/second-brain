# ===========================================================================
# Second Brain — multi-user / multi-tenant configuration
# ===========================================================================

# --- Postgres (per-user store: users, allowlist, encrypted tokens, memory) ---
# Render auto-wires this from the managed DB in render.yaml. For local dev:
DATABASE_URL=postgres://user:pass@localhost:5432/second_brain
# Set PGSSL=disable for a local non-SSL Postgres.
PGSSL=disable

# --- Token encryption (REQUIRED) ---
# 32-byte key, hex (64 chars) or base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENC_KEY=

# --- Sessions ---
SESSION_SECRET=change-this-to-a-random-string-at-least-32-chars

# --- Access control ---
ALLOWED_EMAIL=manish696@gmail.com   # bootstrap admin, seeded into the allowlist on first boot
ADMIN_EMAILS=manish@basisvps.com    # comma-separated extra admins (optional)
ALLOWED_DOMAINS=cadienttalent.com,vorro.net,basisvps.com   # whole-domain sign-up (Google/MS verify the domain)

# --- Google OAuth (login + Gmail/Calendar/Drive data) ---
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
REDIRECT_URI=http://localhost:3000/auth/google/callback   # prod: https://<app>/auth/google/callback

# --- Microsoft / Entra OAuth (login only) ---
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT=common                    # 'common', 'organizations', or a tenant GUID
MS_REDIRECT_URI=http://localhost:3000/auth/microsoft/callback

# --- Zoho OAuth apps (shared client; each user grants their own refresh token) ---
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REDIRECT_URI=http://localhost:3000/connect/zoho/callback
ZOHO_ACCOUNTS_HOST=https://accounts.zoho.com
# Vorro (India DC)
VORRO_ZOHO_CLIENT_ID=
VORRO_ZOHO_CLIENT_SECRET=
VORRO_ZOHO_ACCOUNTS_HOST=https://accounts.zoho.in
VORRO_ZOHO_TOKEN_URL=https://accounts.zoho.in/oauth/v2/token
VORRO_ZOHO_API_DOMAIN=https://www.zohoapis.in

# --- AI / other ---
ANTHROPIC_API_KEY=your-anthropic-api-key
PORT=3000

# NOTE: GOOGLE_REFRESH_TOKEN / ZOHO_REFRESH_TOKEN / VORRO_ZOHO_REFRESH_TOKEN are
# NO LONGER used. Tokens are now per-user, encrypted, and stored in Postgres.

# --- HubSpot CRM (OAuth app; each user grants their own refresh token) ---
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_REDIRECT_URI=http://localhost:3000/connect/hubspot/callback

# --- Microsoft 365 data connection (calendar + Teams transcripts) ---
# Login uses the MS_* vars above; the data connection reuses the same Entra app
# but requests Calendars.Read / OnlineMeetings / transcript scopes + offline_access.
MS_DATA_REDIRECT_URI=http://localhost:3000/connect/microsoft/callback

# --- Recall.ai (Teams/Zoom/Meet meeting-bot transcription; single API key) ---
# Each user can store their own key in Connections; this env key is an admin fallback.
RECALL_API_KEY=
RECALL_REGION=us-east-1
