}

function getDealsForBrand(brand){
  if(brand==='cadient')return _cadientDeals;
  if(brand==='vorro')return _vorroDeals;
  return[..._cadientDeals,..._vorroDeals];
}

function renderPipelineView(brand){
  let allDeals=getDealsForBrand(brand);

  // Populate stage filter dropdown from current deals
  const allStages=[...new Set(allDeals.map(d=>d.Stage||'Unknown'))].sort();
  const sf=document.getElementById('stageFilter');
  if(sf){
    const prev=_currentStageFilter;
    sf.innerHTML='<option value="">All Stages ('+allDeals.length+')</option>'+allStages.map(s=>'<option value="'+esc(s)+'"'+(s===prev?' selected':'')+'>'+esc(s.replace(/^S\d+: /,''))+' ('+allDeals.filter(d=>(d.Stage||'Unknown')===s).length+')</option>').join('');
  }

  // Apply stage filter
  let deals=_currentStageFilter?allDeals.filter(d=>(d.Stage||'Unknown')===_currentStageFilter):allDeals;

  const totalVal=deals.reduce((s,d)=>s+(d.Amount||0),0);
  const sumEl=document.getElementById('pipelineSummary');
  if(sumEl)sumEl.textContent=`${deals.length} deals | ${fmtMoney(totalVal)} total`;

  const stages={};const owners={};
  deals.forEach(d=>{
    const s=d.Stage||'Unknown';
    if(!stages[s])stages[s]={count:0,value:0};
    stages[s].count++;stages[s].value+=(d.Amount||0);
    const o=d.Owner?.name||d.Owner||'Unassigned';
    if(!owners[o])owners[o]={count:0,value:0};
    owners[o].count++;owners[o].value+=(d.Amount||0);
  });

  const psEl=document.getElementById('pipelineStages');
  if(psEl)psEl.innerHTML=Object.entries(stages).sort((a,b)=>b[1].value-a[1].value).slice(0,8).map(([s,d])=>
    `<div class="stage-pill" style="cursor:pointer" onclick="document.getElementById('stageFilter').value='${escAttr(s)}';applyStageFilter()"><div class="num">${d.count}</div><div class="lbl">${esc(s.replace(/^S\d+: /,''))}</div><div class="lbl">${fmtMoney(d.value)}</div></div>`
  ).join('');

  if(_pipeChartInstance){_pipeChartInstance.destroy();_pipeChartInstance=null;}
  if(_ownerChartInstance){_ownerChartInstance.destroy();_ownerChartInstance=null;}

  const stageLabels=Object.keys(stages);
  const stageValues=stageLabels.map(s=>stages[s].value);
  const pcEl=document.getElementById('pipelineChart');
  if(pcEl)_pipeChartInstance=new Chart(pcEl,{type:'bar',data:{labels:stageLabels.map(s=>s.replace(/^S\d+: /,'')),datasets:[{label:'Pipeline Value',data:stageValues,backgroundColor:['#bbdefb','#c8e6c9','#fff9c4','#ffccbc','#d1c4e9','#f8bbd0','#b2dfdb','#ffe0b2']}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},scales:{y:{ticks:{callback:v=>fmtMoney(v)}}}}});

  const ownerLabels=Object.keys(owners);
  const ownerValues=ownerLabels.map(o=>owners[o].value);
  const ocEl=document.getElementById('ownerChart');
  if(ocEl)_ownerChartInstance=new Chart(ocEl,{type:'doughnut',data:{labels:ownerLabels,datasets:[{data:ownerValues,backgroundColor:['#42a5f5','#66bb6a','#ffa726','#ef5350','#ab47bc','#26c6da','#78909c','#8d6e63']}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{position:'right',labels:{font:{size:10}}}}}});

  // Collect unique owners for the owner dropdown
  const ownerList=[...new Set(deals.map(d=>d.Owner?.name||d.Owner||'').filter(Boolean))].sort();

  const el=document.getElementById('allDeals');if(!el)return;
  if(!deals.length){el.innerHTML='<div class="empty-state">No deals found'+ (_currentStageFilter?' for this stage':'')+'</div>';return;}
  el.innerHTML=deals.map((d,idx)=>{
    const tag=d._brand==='vorro'?'<span style="background:#e8f5e9;color:#2e7d32;font-size:9px;padding:1px 4px;border-radius:3px;margin-left:4px">Vorro</span>':'<span style="background:#e3f2fd;color:#1565c0;font-size:9px;padding:1px 4px;border-radius:3px;margin-left:4px">Cadient</span>';
    const ownerName=d.Owner?.name||d.Owner||'';
    const acctName=d.Account_Name?.name||d.Account_Name||'';
    const dealId=d.id||'';
    const isCadient=d._brand==='cadient';
    const stageList=isCadient?CADIENT_STAGES:VORRO_STAGES;
    const stageSpanId='stg_'+idx;
