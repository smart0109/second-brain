function addTaskIfNew(col,task){
  const key=(task.title||'').toLowerCase().trim();
  const exists=Object.values(prodTasks).flat().some(t=>(t.title||'').toLowerCase().trim()===key);
  if(!exists&&key.length>2){
    task.id='t_'+Date.now()+'_'+Math.random().toString(36).slice(2,6);
    task.created=new Date().toISOString().slice(0,10);
    prodTasks[col].push(task);
  }
}

function renderKanban(){
  ['active','waiting','someday','done'].forEach(col=>{
    const container=document.getElementById('cards'+col.charAt(0).toUpperCase()+col.slice(1));
    const count=document.getElementById('cnt'+col.charAt(0).toUpperCase()+col.slice(1));
    if(!container||!count)return;
    const tasks=prodTasks[col]||[];
    count.textContent=tasks.length;
    container.innerHTML=tasks.map(t=>{
      const isOverdue=t.due&&new Date(t.due)<new Date()&&col!=='done';
      const sourceIcon={calendar:'&#128197;',email:'&#9993;',granola:'&#127793;',crm:'&#128178;',manual:'&#128221;'}[t.source]||'&#128221;';
      return `<div class="kanban-card" data-id="${t.id}">
        <div class="kc-actions">
          ${col!=='done'?`<button onclick="moveTask('${t.id}','done')" title="Complete">&#10003;</button>`:''}
          ${col!=='active'&&col!=='done'?`<button onclick="moveTask('${t.id}','active')" title="Move to Active">&#9654;</button>`:''}
          ${col==='active'?`<button onclick="moveTask('${t.id}','waiting')" title="Waiting">&#9202;</button>`:''}
          <button onclick="removeTask('${t.id}')" title="Remove">&#10005;</button>
        </div>
        <div class="kc-title">${esc(t.title)}</div>
        ${t.context?`<div class="kc-context">${esc(t.context)}</div>`:''}
        <div class="kc-meta">
          <span class="kc-tag" style="background:#f5f5f5;color:#666">${sourceIcon}</span>
          ${t.person?`<span class="kc-tag person">${esc(t.person)}</span>`:''}
          ${t.due?`<span class="kc-tag due ${isOverdue?'overdue':''}">${isOverdue?'OVERDUE ':''} ${t.due}</span>`:''}
          ${t.created&&!t.due?`<span class="kc-tag since">since ${t.created}</span>`:''}
        </div>
      </div>`;
    }).join('')||'<div class="memory-empty">No tasks</div>';
  });
}

function moveTask(id,toCol){
  for(const col of ['active','waiting','someday','done']){
    const idx=prodTasks[col].findIndex(t=>t.id===id);
    if(idx>-1){
      const task=prodTasks[col].splice(idx,1)[0];
      if(toCol==='done')task.completed=new Date().toISOString().slice(0,10);
      prodTasks[toCol].push(task);
      break;
    }
  }
  renderKanban();
}

function removeTask(id){
  for(const col of ['active','waiting','someday','done']){
    const idx=prodTasks[col].findIndex(t=>t.id===id);
    if(idx>-1){prodTasks[col].splice(idx,1);break;}
  }
  renderKanban();
}

