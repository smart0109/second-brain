      context.push({type:'text',text:'CALENDAR EVENTS:\n'+events.join('\n')});
    }

    const aiResult=await ask(
      'Analyze these activity sources and extract ALL action items, follow-ups, and tasks that Manish needs to do. For each, classify as: active (needs doing now), waiting (blocked on someone), or someday (nice to have). Return JSON: {"active":[{"title":"...","person":"...","context":"...","due":"..."}], "waiting":[...], "someday":[...]}. ONLY valid JSON.',
      context
    );

    try{
