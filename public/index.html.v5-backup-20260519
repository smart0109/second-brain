        else if(loc.includes('zoom.us')){platform='Zoom';joinUrl=loc;}
        else if(loc.includes('teams.microsoft.com')||loc.includes('teams.live.com')){platform='Microsoft Teams';joinUrl=loc;}
      }
      const _cmt=document.getElementById('copilotMeetingTitle');if(_cmt)_cmt.textContent=(m.summary||'Meeting')+' ('+platform+')';
      const start=m.start?.dateTime||m.start?.date||'';
