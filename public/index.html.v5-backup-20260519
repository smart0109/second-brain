  const history=historyR.status==='fulfilled'?historyR.value:null;
  if(history){
    const hText=typeof history==='string'?history:(history?.answer||history?.text||JSON.stringify(history));
    if(hText&&hText.length>20){
      html+='<div class="section-header">Previous Meeting History</div>';
      html+='<div class="mtg-transcript-box">'+renderMarkdown(hText.slice(0,1000))+'</div>';
    }
  }

  el.innerHTML=html||'<div style="font-size:10px;color:#999;padding:4px 0">No previous context found for attendees</div>';
}

