async function loadVorroPipelineCache(){
  try{
    const threads=await call(`${GMAIL}__search_threads`,{query:'subject:[VORRO-PIPELINE-CACHE] in:draft',pageSize:3});
    if(!threads?.threads?.length){
      // Fallback: search without in:draft
      const t2=await call(`${GMAIL}__search_threads`,{query:'subject:[VORRO-PIPELINE-CACHE]',pageSize:3});
      if(!t2?.threads?.length){dbg('No Vorro pipeline cache found','err');return [];}
      const thread=await call(`${GMAIL}__get_thread`,{threadId:t2.threads[0].id});
      const msg=thread?.messages?.[0];
      const body=msg?.plaintextBody||msg?.body||msg?.snippet||'';
      try{const data=JSON.parse(body);return data?.data||data?.deals||[];}catch(e){const m=body.match(/\{[\s\S]*\}/);if(m){const d=JSON.parse(m[0]);return d?.data||d?.deals||[];}return [];}
    }
    const thread=await call(`${GMAIL}__get_thread`,{threadId:threads.threads[0].id});
    const msg=thread?.messages?.[0];
    const body=msg?.plaintextBody||msg?.body||msg?.snippet||'';
    try{const data=JSON.parse(body);return data?.data||data?.deals||[];}catch(e){const m=body.match(/\{[\s\S]*\}/);if(m){const d=JSON.parse(m[0]);return d?.data||d?.deals||[];}return [];}
  }catch(e){dbg('Vorro cache read failed: '+e.message,'err');return [];}
}

async function loadPipeline(){
  window._pipeLoaded=true;
  const [cadR,vorR]=await Promise.allSettled([
    call(`${ZOHO}__executeCOQLQuery`,{body:{select_query:"select Deal_Name,Stage,Amount,Closing_Date,Contact_Name,Account_Name,Owner,Probability,Pipeline from Deals where Stage != 'Closed Won' and Stage != 'Closed Lost' order by Amount desc limit 200"}}),
    loadVorroPipelineCache()
  ]);
  _cadientDeals=(cadR.status==='fulfilled'?(cadR.value?.data||[]):[]).map(d=>({...d,_brand:'cadient'}));
  _vorroDeals=(vorR.status==='fulfilled'?(vorR.value||[]):[]).map(d=>({...d,_brand:'vorro'}));
  dbg(`Pipeline: Cadient ${_cadientDeals.length}, Vorro ${_vorroDeals.length} deals`,'ok');
  renderPipelineView('cadient');
}

let _currentPipeBrand='cadient';
let _currentStageFilter='';
const CADIENT_STAGES=['Qualification','Needs Analysis','Proposal/Price Quote','Negotiation/Review','Closed Won','Closed Lost','In Progress','Delivered','Delivered without Meeting'];
const VORRO_STAGES=['S1: Qualification','S2: Discovery','S3: Solution Development/SOW','S3: Evaluation/Scoping','S4: Proposal','S5: Verbal/Negotiation','S6: Contracting','Closed Won','Closed Lost'];

function switchPipelineBrand(brand){
