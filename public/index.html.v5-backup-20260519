async function loadStaleThreads(){
  const el=document.getElementById('staleAlerts');
  if(!el)return;
  dbg('loadStaleThreads() started');

  // Search for threads from VIPs and key prospects where last message is >5 days old
  // Look for threads where Manish was the recipient (from:VIP) and may not have replied
  const vips=['ambarish@basisvectors.com','bmastin@cadienttalent.com','abaker@vorro.net','ssirdevan@vorro.net',
    'prateek@cadienttalent.com','scott@vorro.net','terry@vorro.net'];
  const query=vips.map(e=>'from:'+e).join(' OR ')+' older_than:5d newer_than:30d -in:draft';

  try{
    const r=await call(`${GMAIL}__search_threads`,{query:query,pageSize:20});
    const threads=(r?.threads||[]);
    if(!threads.length){el.style.display='none';return;}

    // Filter: only threads where the LAST message is FROM the VIP (meaning Manish hasn't replied)
    const stale=[];
    for(const t of threads){
      const msgs=t.messages||[];
      const last=msgs[msgs.length-1];
      if(!last)continue;
      const fromEmail=(last.sender||'').toLowerCase();
      const isFromVip=vips.some(v=>fromEmail.includes(v.split('@')[0]));
      if(!isFromVip)continue;
      const daysSince=Math.floor((Date.now()-new Date(last.date).getTime())/(1000*60*60*24));
      if(daysSince>=5){
        stale.push({thread:t,last,daysSince,sender:last.sender});
      }
    }

    if(!stale.length){el.style.display='none';return;}

    stale.sort((a,b)=>b.daysSince-a.daysSince);
    el.style.display='block';
    el.innerHTML=`<div class="stale-banner">
      <div class="sb-title">&#9888; ${stale.length} thread${stale.length>1?'s':''} awaiting your reply</div>
      ${stale.slice(0,6).map(s=>{
        const name=s.sender.split('@')[0].replace(/[._]/g,' ');
        return `<div class="stale-item">
          <span class="stale-days">${s.daysSince}d</span>
          <a href="${gmailUrl(s.thread.id)}" target="_blank" style="color:#333;text-decoration:none;flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">
            <strong>${esc(name)}</strong>: ${esc(truncate(s.last.subject||'(no subject)',45))}
          </a>
        </div>`;
      }).join('')}
      ${stale.length>6?`<div style="font-size:10px;color:#e65100;margin-top:4px">+ ${stale.length-6} more</div>`:''}
    </div>`;
    dbg('Stale threads: '+stale.length+' awaiting reply','ok');
  }catch(e){
    dbg('Stale threads failed: '+e.message,'err');
    el.style.display='none';
  }
}

