function showDealStageEdit(spanId,dealId,currentStage,idx){
  const span=document.getElementById(spanId);if(!span)return;
  const isCadient=_currentPipeBrand!=='vorro';
  const stageList=isCadient?CADIENT_STAGES:VORRO_STAGES;
  const sel=document.createElement('select');
  sel.className='deal-select';
  sel.innerHTML=stageList.map(s=>'<option value="'+esc(s)+'"'+(s===currentStage?' selected':'')+'>'+esc(s)+'</option>').join('');
  sel.onchange=async function(){
    const newStage=sel.value;
    sel.disabled=true;
    try{
      await call(`${ZOHO}__updateRecord`,{path_variables:{module:'Deals',recordID:dealId},body:{data:[{id:dealId,Stage:newStage}]}});
      // Update local data
      const allDeals=getDealsForBrand(_currentPipeBrand);
      const deal=allDeals.find(d=>d.id===dealId);
      if(deal)deal.Stage=newStage;
      sel.remove();
      span.textContent=newStage;
      span.style.display='';
      const ok=document.createElement('span');ok.className='deal-save-ok';ok.textContent='Saved';
      span.after(ok);setTimeout(()=>ok.remove(),2000);
      dbg('Deal '+dealId+' stage updated to '+newStage,'ok');
    }catch(e){
      sel.disabled=false;
      const err=document.createElement('span');err.className='deal-save-err';err.textContent='Failed';
      sel.after(err);setTimeout(()=>err.remove(),3000);
      dbg('Deal stage update failed: '+e.message,'err');
    }
  };
  sel.onblur=function(){if(!sel.disabled){span.style.display='';sel.remove();}};
  span.style.display='none';
  span.parentNode.insertBefore(sel,span);
  sel.focus();
}

function showDealOwnerEdit(spanId,dealId,currentOwner,idx){
  const span=document.getElementById(spanId);if(!span)return;
  // Collect owners from current dataset
  const allDeals=getDealsForBrand(_currentPipeBrand);
  const ownerList=[...new Set(allDeals.map(d=>d.Owner?.name||d.Owner||'').filter(Boolean))].sort();
  const sel=document.createElement('select');
  sel.className='deal-select';
  sel.innerHTML=ownerList.map(o=>'<option value="'+esc(o)+'"'+(o===currentOwner?' selected':'')+'>'+esc(o)+'</option>').join('');
  sel.onchange=async function(){
    const newOwner=sel.value;
    sel.disabled=true;
    // Find the owner's Zoho user ID from other deals
    const refDeal=allDeals.find(d=>(d.Owner?.name||d.Owner)===newOwner&&d.Owner?.id);
    const ownerId=refDeal?.Owner?.id;
    try{
      const updateData={id:dealId};
      if(ownerId)updateData.Owner={id:ownerId};
      else updateData.Owner=newOwner;
      await call(`${ZOHO}__updateRecord`,{path_variables:{module:'Deals',recordID:dealId},body:{data:[updateData]}});
      const deal=allDeals.find(d=>d.id===dealId);
      if(deal){if(typeof deal.Owner==='object')deal.Owner.name=newOwner;else deal.Owner=newOwner;}
      span.textContent=newOwner;
      span.style.display='';sel.remove();
      const ok=document.createElement('span');ok.className='deal-save-ok';ok.textContent='Saved';
      span.after(ok);setTimeout(()=>ok.remove(),2000);
      dbg('Deal '+dealId+' owner updated to '+newOwner,'ok');
    }catch(e){
      sel.disabled=false;
      const err=document.createElement('span');err.className='deal-save-err';err.textContent='Failed';
      sel.after(err);setTimeout(()=>err.remove(),3000);
      dbg('Deal owner update failed: '+e.message,'err');
    }
  };
  sel.onblur=function(){if(!sel.disabled){span.style.display='';sel.remove();}};
  span.style.display='none';
  span.parentNode.insertBefore(sel,span);
  sel.focus();
}

