function renderCopilotResponse(type,text){
  const headers={
    explain:'&#128161; Explanation',
    rebuttal:'&#9889; Rebuttal',
    tone:'&#127912; Tone Analysis',
    advise:'&#128172; What to Say Next'
  };
  const colors={explain:'#2196f3',rebuttal:'#ff9800',tone:'#9c27b0',advise:'#4caf50'};
  const headerEl=document.querySelector('.copilot-response .cr-header');
  headerEl.innerHTML=`<span style="color:${colors[type]}">${headers[type]}</span>`;
  const body=document.getElementById('copilotResponseBody');

  if(type==='tone'){
    // Parse tone and show pills
    const toneMatch=text.match(/(interested|skeptical|hostile|engaged|confused|excited|neutral|positive|negative|curious|cautious|warm|defensive)/gi);
    const tones=(toneMatch||['neutral']).slice(0,3);
    const toneClasses={interested:'positive',engaged:'positive',excited:'positive',warm:'positive',positive:'positive',
      skeptical:'neutral',confused:'neutral',cautious:'neutral',neutral:'neutral',
      hostile:'negative',defensive:'negative',negative:'negative',curious:'curious'};
    body.innerHTML=`<div class="copilot-tone-bar">${tones.map(t=>`<span class="copilot-tone-pill tone-${toneClasses[t.toLowerCase()]||'neutral'}">${esc(t)}</span>`).join('')}</div>
      <div style="font-size:12px;line-height:1.7;color:#333">${esc(text)}</div>`;
