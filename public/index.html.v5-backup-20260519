function parseMeetings(raw){
  if(!raw)return[];const s=typeof raw==='string'?raw:JSON.stringify(raw);const ms=[];
  const re=/<meeting id="([^"]*)" title="([^"]*)" date="([^"]*)">\s*<known_participants>\s*([\s\S]*?)\s*<\/known_participants>/g;
  let m;while((m=re.exec(s))!==null){ms.push({id:m[1],title:m[2],date:m[3],parts:m[4].trim()})}return ms;
}

function renderGranolaMeetings(raw,targetId){
  const el=document.getElementById(targetId);const ms=parseMeetings(raw);
  if(!ms.length){el.innerHTML='<div class="empty-state">No meetings</div>';return}
  el.innerHTML=ms.map((m,i)=>{
    const ppl=m.parts.split(',').map(p=>p.trim().split(' from ')[0].split('<')[0].trim()).filter(Boolean).slice(0,4);
    const emails=(m.parts.match(/[\w.-]+@[\w.-]+\.\w+/g)||[]);
    const uid=targetId+'_'+i;
    const notesId='notes_'+uid;
    return `<div class="item" style="cursor:pointer;padding-bottom:0" onclick="toggleMeetingContext('${uid}','${escAttr(m.title)}','${escAttr(emails.join(','))}','${escAttr(ppl.join(','))}','${escAttr(m.id)}')">
      <div class="item-row">
        <div class="item-icon granola">&#128221;</div>
        <div class="item-content"><div class="item-title">${esc(m.title)}</div>
        <div class="item-sub">${esc(m.date)} &middot; ${esc(ppl.join(', '))}</div></div>
        <span class="notes-link active" id="${notesId}" onclick="event.stopPropagation();toggleMeetingNotes('${notesId}','${escAttr(m.id)}')">Notes</span>
      </div>
      <div id="${notesId}_content" style="display:none"></div>
      <div id="${uid}" class="meeting-context" style="display:none"></div>
    </div>`;
  }).join('');
  // Probe transcripts to grey out Notes links where unavailable (throttled to 3 concurrent)
  (async()=>{
    const batch=3;
    for(let i=0;i<ms.length;i+=batch){
      await Promise.allSettled(ms.slice(i,i+batch).map((m,j)=>probeTranscript('notes_'+targetId+'_'+(i+j),m.id)));
    }
  })();
}

async function probeTranscript(notesId,meetingId){
  if(!meetingId){greyOutNotes(notesId);return;}
  try{
    const t=await call(`${GRAN}__get_meeting_transcript`,{meetingId:meetingId});
    const text=t?(typeof t==='string'?t:(t?.transcript||t?.text||'')):'' ;
    if(!text||text.length<20)greyOutNotes(notesId);
  }catch(e){greyOutNotes(notesId);}
}

function greyOutNotes(notesId){
  const el=document.getElementById(notesId);
  if(el){el.className='notes-link greyed';el.onclick=null;el.title='No transcript available';}
}

async function toggleMeetingNotes(notesId,meetingId){
  const contentEl=document.getElementById(notesId+'_content');
  const linkEl=document.getElementById(notesId);
  if(!contentEl||!linkEl)return;
  // Toggle if already loaded
  if(contentEl.dataset.loaded==='1'){contentEl.style.display=contentEl.style.display==='none'?'block':'none';return;}
  contentEl.style.display='block';
  contentEl.innerHTML='<div class="loading" style="padding:6px"><div class="spinner"></div> Loading transcript...</div>';
  try{
    const t=await call(`${GRAN}__get_meeting_transcript`,{meetingId:meetingId});
    const text=t?(typeof t==='string'?t:(t?.transcript||t?.text||JSON.stringify(t))):'';
    if(text&&text.length>20){
      contentEl.innerHTML='<div class="notes-content">'+renderMarkdown(text.slice(0,3000))+'</div>';
      contentEl.dataset.loaded='1';
    }else{
