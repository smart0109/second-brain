function renderMarkdown(text){
  if(!text)return '';
  let s=typeof text==='string'?text:JSON.stringify(text);
  s=s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  s=s.replace(/\[\[(\d+)\]\]\((https?:\/\/[^\)]+)\)/g,'<a href="$2" target="_blank" class="action-link">[$1]</a>');
  s=s.replace(/^### (.+)$/gm,'<h4 style="font-size:12px;font-weight:600;margin:10px 0 4px;color:#333">$1</h4>');
  s=s.replace(/^## (.+)$/gm,'<h3 style="font-size:13px;font-weight:700;margin:12px 0 6px;color:#1a1a2e">$1</h3>');
  s=s.replace(/^---$/gm,'<hr style="border:none;border-top:1px solid #e5e7eb;margin:10px 0">');
  s=s.replace(/\*\*(.+?)\*\*/g,'<strong>$1</strong>');
  s=s.replace(/^- (.+)$/gm,'<div style="padding:1px 0 1px 14px;position:relative"><span style="position:absolute;left:3px;color:#999">&#8226;</span>$1</div>');
  s=s.replace(/\n\n/g,'<div style="height:6px"></div>');
  s=s.replace(/\n/g,'<br>');
  return s;
}

