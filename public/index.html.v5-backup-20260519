  const now=new Date();
  const twoHours=new Date(now.getTime()+7200000);
  try{
    const calR=await call(`${CAL}__list_events`,{startTime:now.toISOString(),endTime:twoHours.toISOString(),timeZone:'America/New_York',orderBy:'startTime'});
    const events=calR?.events||[];
    if(events.length){
      copilotCurrentMeeting=events[0];
      const m=copilotCurrentMeeting;
      // Detect conference platform from conferenceUrl or location field
      const confUrl=m.conferenceUrl||m.location||'';
      let platform='Calendar';
      let joinUrl='';
      if(confUrl.includes('meet.google.com')){platform='Google Meet';joinUrl=confUrl;}
      else if(confUrl.includes('zoom.us')){platform='Zoom';joinUrl=confUrl;}
      else if(confUrl.includes('teams.microsoft.com')||confUrl.includes('teams.live.com')){platform='Microsoft Teams';joinUrl=confUrl;}
