// Thread pin/remove state (persisted in localStorage)
const _threadPins=JSON.parse(localStorage.getItem('sb_thread_pins')||'[]');
const _threadDismissed=JSON.parse(localStorage.getItem('sb_thread_dismissed')||'[]');
let _allThreads=[];

function pinThread(threadId,evt){
  evt.preventDefault();evt.stopPropagation();
  const idx=_threadPins.indexOf(threadId);
  if(idx>-1)_threadPins.splice(idx,1);else _threadPins.push(threadId);
  localStorage.setItem('sb_thread_pins',JSON.stringify(_threadPins));
  renderThreads(_allThreads);
}
function dismissThread(threadId,evt){
  evt.preventDefault();evt.stopPropagation();
  if(!_threadDismissed.includes(threadId)){_threadDismissed.push(threadId);localStorage.setItem('sb_thread_dismissed',JSON.stringify(_threadDismissed));}
  renderThreads(_allThreads);
}
function undoDismissAll(){
  _threadDismissed.length=0;localStorage.setItem('sb_thread_dismissed','[]');
  renderThreads(_allThreads);
}

