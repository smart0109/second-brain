async function toggleThreadContext(ctxId,threadId,sender,subject,lastMsgId){
  const el=document.getElementById(ctxId);if(!el)return;
  // Toggle visibility if already loaded (has data-loaded flag, no spinner)
  if(el.dataset.loaded==='1'){el.style.display=el.style.display==='none'?'block':'none';return;}
  el.style.display='block';
  el.innerHTML='<div class="loading" style="padding:8px"><div class="spinner"></div> Loading thread context and drafting reply...</div>';

  try{
    // Step 1: Fetch full thread + Granola history in parallel
    const senderName=sender.split('@')[0].replace(/[._]/g,' ');
    const senderDomain=sender.split('@')[1]||'';
    const [threadR,granolaR]=await Promise.allSettled([
      call(`${GMAIL}__get_thread`,{threadId:threadId}),
      call(`${GRAN}__query_granola_meetings`,{query:'All meetings and notes involving '+senderName+' from '+senderDomain+'. Key topics, decisions, action items, relationship context, commitments made.'}).catch(()=>null)
    ]);

    const thread=threadR.status==='fulfilled'?threadR.value:null;
    const msgs=(thread?.messages||[]).slice(-10);
    // Capture last message ID for reply threading
    const replyMsgId=msgs.length?(msgs[msgs.length-1].id||lastMsgId):lastMsgId;

    // Build conversation summary for the notes pane
    const convParts=msgs.map(m=>{
      const body=m.plaintextBody||m.body||m.snippet||'';
      const from=m.sender||'';
      const date=m.date?new Date(m.date).toLocaleString('en-US',{month:'short',day:'numeric',hour:'numeric',minute:'2-digit'}):'';
      return {from,date,body:body.slice(0,600),subject:m.subject||''};
    });

    // Granola context
    const granola=granolaR.status==='fulfilled'?granolaR.value:null;
    const granolaText=granola?(typeof granola==='string'?granola:(granola?.answer||granola?.text||JSON.stringify(granola))):'';

    // Build the context data for askClaude
    const contextData=[];
    contextData.push('EMAIL THREAD ('+msgs.length+' messages, subject: '+subject+'):\n'+convParts.map(m=>'FROM: '+m.from+' ('+m.date+')\n'+m.body).join('\n---\n'));
    if(granolaText&&granolaText.length>20)contextData.push('GRANOLA MEETING NOTES:\n'+granolaText.slice(0,2000));

    // Step 2: Ask Claude for notes summary + draft reply in parallel
    const [notesR,draftR]=await Promise.allSettled([
      ask('You are Manish\'s CRO executive assistant. Summarize this email thread into a concise notes pane. Include: (1) Key topic/ask, (2) Open questions or action items, (3) Any commitments or deadlines mentioned, (4) Relationship context from meeting notes if available. Be brief and scannable. Use short paragraphs, no bullet points.',contextData),
      ask('You are drafting a reply email for Manish (CRO at Basis Vectors Capital, managing Cadient and Vorro). Write a professional, warm, direct reply to the latest message in this thread. Use context from the full thread and any meeting notes. Keep it concise (3-5 sentences typical). Do NOT include subject line, greetings like "Hi [name]", or signature — Manish will add those. Just write the reply body. Match the tone of the conversation.',contextData)
    ]);

    const notes=notesR.status==='fulfilled'?notesR.value:'Could not generate summary.';
    const draft=draftR.status==='fulfilled'?draftR.value:'Could not generate draft.';

    // Render the context pane
    let html='';

    // Notes section
    html+='<div class="section-header">Thread Notes</div>';
    html+='<div class="thread-notes-box">'+renderMarkdown(notes)+'</div>';

    // Granola meeting history if present
    if(granolaText&&granolaText.length>20){
      html+='<div class="section-header">Meeting History with '+esc(senderName)+'</div>';
      html+='<div class="thread-notes-box" style="max-height:100px">'+renderMarkdown(granolaText.slice(0,1000))+'</div>';
    }

    // Conversation thread (collapsed by default)
    if(convParts.length>1){
      const convId='conv_'+threadId.replace(/[^a-zA-Z0-9]/g,'');
      html+='<div class="section-header" style="cursor:pointer" onclick="const c=document.getElementById(\''+convId+'\');c.style.display=c.style.display===\'none\'?\'block\':\'none\'">Thread Messages ('+convParts.length+') &#9660;</div>';
      html+='<div id="'+convId+'" style="display:none;max-height:200px;overflow-y:auto;background:#f8f9fb;border-radius:4px;padding:6px;margin:4px 0">';
      html+=convParts.map(m=>`<div class="thread-msg-item"><span class="thread-msg-from">${esc(m.from.split('@')[0])}</span><span class="thread-msg-date">${m.date}</span><div class="thread-msg-body">${esc(truncate(m.body,300))}</div></div>`).join('');
      html+='</div>';
    }

    // Draft reply — store metadata as data attributes for createDraftFromThread
    html+='<div class="section-header">Draft Reply</div>';
    const draftId='draft_'+threadId.replace(/[^a-zA-Z0-9]/g,'');
    html+='<div class="thread-draft-box" data-thread-id="'+esc(threadId)+'" data-reply-msg-id="'+esc(replyMsgId)+'" data-subject="'+esc(subject)+'" data-to="'+esc(sender)+'">';
    html+='<div id="'+draftId+'" contenteditable="true" style="outline:none;min-height:40px">'+esc(draft)+'</div>';
    html+='<div class="draft-actions">';
    html+='<button class="draft-btn primary" onclick="createDraftFromThread(this,event)">Create Gmail Draft</button>';
    html+='<button class="draft-btn" onclick="copyDraftText(this,event)">Copy</button>';
    html+='<button class="draft-btn" onclick="regenerateDraft(this,event)">Regenerate</button>';
    html+='</div></div>';

    el.innerHTML=html;
    el.dataset.loaded='1';
    dbg('Thread context loaded: '+threadId+' notes='+notes.length+'chars draft='+draft.length+'chars','ok');

  }catch(e){
    el.innerHTML='<div style="padding:8px;font-size:11px;color:#c62828">Failed to load context: '+esc(e.message)+'</div>';
    dbg('toggleThreadContext error: '+e.message,'err');
  }
}

async function createDraftFromThread(btnEl,evt){
  evt.stopPropagation();
  const box=btnEl.closest('.thread-draft-box');if(!box)return;
  const draftDiv=box.querySelector('[contenteditable]');if(!draftDiv)return;
  const body=draftDiv.innerText||draftDiv.textContent||'';
  const subject=box.dataset.subject||'';
  const toAddr=box.dataset.to||'';
  const replyMsgId=box.dataset.replyMsgId||'';
  const threadId=box.dataset.threadId||'';
  btnEl.textContent='Creating...';btnEl.disabled=true;
  try{
    const reSubject=subject.startsWith('Re:')?subject:'Re: '+subject;
    const draftParams={subject:reSubject,body:body,to:[toAddr]};
    if(replyMsgId)draftParams.replyToMessageId=replyMsgId;
    await call(`${GMAIL}__create_draft`,draftParams);
    btnEl.textContent='Draft Created!';btnEl.style.background='#4caf50';btnEl.style.borderColor='#4caf50';
    dbg('Gmail draft created for thread '+threadId+' (reply to msg '+replyMsgId+')','ok');
    setTimeout(()=>{btnEl.textContent='Create Gmail Draft';btnEl.style.background='';btnEl.style.borderColor='';btnEl.disabled=false;},3000);
  }catch(e){
    btnEl.textContent='Failed';btnEl.style.background='#ef5350';btnEl.style.borderColor='#ef5350';
    dbg('Draft creation failed: '+e.message,'err');
    setTimeout(()=>{btnEl.textContent='Create Gmail Draft';btnEl.style.background='';btnEl.style.borderColor='';btnEl.disabled=false;},3000);
  }
}

function copyDraftText(btnEl,evt){
  evt.stopPropagation();
  const box=btnEl.closest('.thread-draft-box');if(!box)return;
  const draftDiv=box.querySelector('[contenteditable]');if(!draftDiv)return;
  const text=draftDiv.innerText||draftDiv.textContent||'';
  navigator.clipboard.writeText(text).then(()=>{
    btnEl.textContent='Copied!';setTimeout(()=>{btnEl.textContent='Copy'},1500);
  }).catch(()=>{});
}

async function regenerateDraft(btnEl,evt){
  evt.stopPropagation();
  const box=btnEl.closest('.thread-draft-box');if(!box)return;
  const draftDiv=box.querySelector('[contenteditable]');if(!draftDiv)return;
  const threadId=box.dataset.threadId||'';
  btnEl.textContent='Regenerating...';btnEl.disabled=true;
  try{
    const threadR=await call(`${GMAIL}__get_thread`,{threadId:threadId});
    const msgs=(threadR?.messages||[]).slice(-10);
    const convText=msgs.map(m=>{
      const body=m.plaintextBody||m.body||m.snippet||'';
      return 'FROM: '+(m.sender||'')+'\n'+body.slice(0,600);
    }).join('\n---\n');
    const prevDraft=draftDiv.innerText||'';
    const newDraft=await ask('You are drafting a reply email for Manish (CRO at Basis Vectors Capital). Write a different version of a professional, warm, direct reply to the latest message. Be concise (3-5 sentences). Do NOT include subject line, greeting, or signature. Just the reply body. Try a different angle or tone from this previous draft:\n\n'+prevDraft,[convText]);
    draftDiv.textContent=newDraft;
    btnEl.textContent='Regenerate';btnEl.disabled=false;
  }catch(e){
    btnEl.textContent='Failed';setTimeout(()=>{btnEl.textContent='Regenerate';btnEl.disabled=false;},2000);
  }
}

