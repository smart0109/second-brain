// ── Objection Detection ──
const OBJECTION_PATTERNS=[
  {pattern:/too expensive|cost too much|budget|can't afford|price is high|pricing concern/i, type:'pricing', brand:'auto'},
  {pattern:/already have|already using|current solution|existing system|happy with what we have/i, type:'existing_solution', brand:'auto'},
  {pattern:/not ready|not the right time|maybe later|next quarter|too soon/i, type:'timing', brand:'auto'},
  {pattern:/need to think|talk to my team|run it by|get approval|decision maker/i, type:'stakeholder', brand:'auto'},
  {pattern:/competitor|other vendor|alternative|also looking at|compared to/i, type:'competitor', brand:'auto'},
  {pattern:/implementation|how long|timeline|disruption|migration/i, type:'implementation', brand:'auto'},
  {pattern:/hipaa|compliance|security|data privacy|audit/i, type:'compliance', brand:'vorro'},
  {pattern:/integration.*complex|too many systems|point.to.point/i, type:'complexity', brand:'vorro'}
];

function checkObjections(text){
  for(const p of OBJECTION_PATTERNS){
    if(p.pattern.test(text)){
      generateAutoRebuttal(text,p.type,p.brand);
      return;
    }
  }
}

async function generateAutoRebuttal(text,objType,brand){
  const detectedBrand=brand==='auto'?detectBrandFromContext():brand;
  const kb=KNOWLEDGE_BASE[detectedBrand]||KNOWLEDGE_BASE.cadient;

  // Check for pre-built rebuttals first
  const handlers=kb.objectionHandlers;
  let quickRebuttal='';
  for(const[key,val]of Object.entries(handlers)){
    if(text.toLowerCase().includes(key)||objType.includes(key.split(' ')[0])){
      quickRebuttal=val;break;
    }
  }

  const el=document.getElementById('copilotAutoRebuttal');
  if(quickRebuttal){
    el.innerHTML=`<div class="copilot-auto-rebuttal">
      <div class="car-tag">&#9889; Auto-Rebuttal Detected</div>
      <div class="car-body">${esc(quickRebuttal)}</div>
    </div>`;
  }

  // Also generate a contextual rebuttal via AI
  try{
    const ctx=[
      {label:'Objection detected',value:text},
      {label:'Objection type',value:objType},
      {label:'Meeting context',value:copilotMeetingContext},
      {label:'Full transcript',value:getRecentTranscript(5)},
      {label:'Product knowledge',value:getKnowledgeString()}
    ];
    const aiRebuttal=await ask(
      `You are a CRO's real-time meeting coach for ${kb.company}. The prospect just raised an objection. Generate a natural, conversational rebuttal that Manish can say immediately. Be specific with data and metrics. Keep it under 80 words. Do NOT use bullet points.`,
      ctx
    );
    el.innerHTML=`<div class="copilot-auto-rebuttal">
      <div class="car-tag">&#9889; AI Rebuttal (${esc(objType)})</div>
      <div class="car-body">${esc(aiRebuttal)}</div>
    </div>`;
  }catch(e){}
}

function detectBrandFromContext(){
  const allText=(copilotMeetingContext+' '+getFullTranscript()).toLowerCase();
  if(/fhir|hl7|ehr|epic|cerner|integration|healthcare|hipaa|claims|medicaid|interop/.test(allText))return 'vorro';
  return 'cadient';
}

