    }).join('');
  } else {
    html+='<div style="font-size:10px;color:#999;padding:4px 0">No recent email threads with attendees</div>';
  }

  // Meeting transcript
  const transcript=transcriptR.status==='fulfilled'?transcriptR.value:null;
  if(transcript){
