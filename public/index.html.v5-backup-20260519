    ]);

    // Use AI to extract action items from all sources
    const context=[];
    if(emailR.status==='fulfilled'){
      const threads=emailR.value?.threads||[];
      const subjects=threads.map(t=>{const m=t.messages?.[t.messages.length-1];return m?`Email: ${m.subject} (from ${m.sender})`:''}).filter(Boolean);
