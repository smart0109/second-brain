async function loadCalendarTasks(){
  try{
    const now=new Date();
    const weekEnd=new Date(now);weekEnd.setDate(weekEnd.getDate()+7);
    const calR=await call(`${CAL}__list_events`,{startTime:now.toISOString(),endTime:weekEnd.toISOString(),timeZone:'America/New_York',orderBy:'startTime'});
    const events=calR?.events||[];
    // Extract action items from meetings
    events.forEach(e=>{
      if(e.summary&&(e.summary.toLowerCase().includes('review')||e.summary.toLowerCase().includes('prep')||e.summary.toLowerCase().includes('complete')||e.summary.toLowerCase().includes('deadline'))){
        const d=e.start?.dateTime||e.start?.date||'';
        const att=(e.attendees||[]).filter(a=>!a.self).map(a=>a.displayName||a.email?.split('@')[0]).slice(0,2).join(', ');
        addTaskIfNew('active',{title:e.summary,context:att?'with '+att:'',person:att,due:d?d.slice(0,10):'',source:'calendar'});
      }
    });
  }catch(e){}
}

async function loadEmailTasks(){
  try{
    // Find emails with action keywords
    const r=await call(`${GMAIL}__search_threads`,{query:'subject:(action OR todo OR follow up OR reminder OR deadline OR urgent) newer_than:3d',pageSize:10});
    const threads=r?.threads||[];
    threads.forEach(t=>{
      const msg=t.messages?.[t.messages.length-1]||{};
      if(msg.subject){
        const sender=msg.sender?.split('<')[0]?.trim()||msg.sender?.split('@')[0]||'';
        addTaskIfNew('active',{title:msg.subject,context:'from '+sender,person:sender,due:'',source:'email'});
