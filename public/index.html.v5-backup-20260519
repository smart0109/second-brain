    }
  }catch(e){
    const _cmm3=document.getElementById('copilotMeetingMeta');if(_cmm3)_cmm3.textContent='Calendar sync failed. Use manual input.';
  }
}

async function loadAttendeeContext(attendees){
  if(!attendees.length)return;
  const contextCards=document.getElementById('copilotContextCards');
  contextCards.innerHTML='<div class="loading"><div class="spinner"></div><br>Loading meeting context...</div>';

  const emails=attendees.map(a=>a.email).filter(Boolean);
  const names=attendees.map(a=>a.displayName||a.email?.split('@')[0]).filter(Boolean);

  // Parallel context fetch
  const promises=[];
  emails.forEach(email=>{
    promises.push(call(`${ZOHO}__searchRecords`,{path_variables:{module:'Contacts'},query_params:{email:email,fields:'Full_Name,Email,Title,Phone,Company_Name,Owner,Lead_Source'}}).catch(()=>null));
    promises.push(call(`${ZOHO}__searchRecords`,{path_variables:{module:'Leads'},query_params:{email:email,fields:'Full_Name,Email,Title,Phone,Company,Lead_Source,Lead_Status'}}).catch(()=>null));
  });
  if(names.length){
    promises.push(call(`${GRAN}__query_granola_meetings`,{query:`Summary of past meetings with ${names.join(' and ')}. Key decisions, action items, and relationship context.`}).catch(()=>null));
  }
  // Deals
  promises.push(call(`${ZOHO}__executeCOQLQuery`,{body:{select_query:`select Deal_Name,Stage,Amount,Closing_Date,Contact_Name,Account_Name from Deals where Stage != 'Closed Won' and Stage != 'Closed Lost' order by Amount desc limit 20`}}).catch(()=>null));

  const results=await Promise.allSettled(promises);

  let contextHtml='';
  let contextStr='';

  // CRM records
  const crmRecords=[];
  for(let i=0;i<emails.length*2;i++){
    const r=results[i];
    if(r.status==='fulfilled'&&r.value?.data){
      r.value.data.forEach(rec=>{
        if(!crmRecords.find(c=>c.Email===rec.Email))crmRecords.push(rec);
      });
    }
  }
  if(crmRecords.length){
    const crmStr=crmRecords.map(r=>`${r.Full_Name}: ${r.Title||'?'} at ${r.Company_Name||r.Company||'?'} (${r.Lead_Source||'?'})`).join('; ');
    contextStr+=`ATTENDEE CRM DATA: ${crmStr}. `;
    contextHtml+=`<div class="copilot-ctx-card"><div class="ccc-title">CRM Records</div><div class="ccc-body">${crmRecords.map(r=>
      `<strong>${esc(r.Full_Name||'')}</strong> - ${esc(r.Title||'')} at ${esc(r.Company_Name||r.Company||'')}${r.Lead_Source?' ('+esc(r.Lead_Source)+')':''}`
    ).join('<br>')}</div></div>`;
    copilotAttendeeData.crm=crmRecords;
  }

  // Granola meeting history
  const granolaIdx=emails.length*2;
  const granolaR=results[granolaIdx];
  if(granolaR&&granolaR.status==='fulfilled'&&granolaR.value){
    const gText=typeof granolaR.value==='string'?granolaR.value:JSON.stringify(granolaR.value);
    contextStr+=`PAST MEETING NOTES: ${gText.slice(0,500)}. `;
    contextHtml+=`<div class="copilot-ctx-card"><div class="ccc-title">Past Meetings (Granola)</div><div class="ccc-body" style="max-height:120px;overflow-y:auto">${renderMarkdown(gText)}</div></div>`;
    copilotAttendeeData.meetings=gText;
  }

  // Active deals
  const dealsR=results[granolaIdx+1];
  if(dealsR&&dealsR.status==='fulfilled'&&dealsR.value?.data){
    const deals=dealsR.value.data.slice(0,5);
    contextStr+=`ACTIVE DEALS: ${deals.map(d=>`${d.Deal_Name} (${d.Stage}, ${fmtMoney(d.Amount)})`).join('; ')}. `;
    contextHtml+=`<div class="copilot-ctx-card"><div class="ccc-title">Active Deals</div><div class="ccc-body">${deals.map(d=>
      `<strong>${esc(d.Deal_Name)}</strong> - ${esc(d.Stage)} - ${fmtMoney(d.Amount)}`
    ).join('<br>')}</div></div>`;
    copilotAttendeeData.deals=deals;
  }

  copilotMeetingContext=contextStr;
  contextCards.innerHTML=contextHtml||'<div class="empty-state">No context data found for attendees</div>';
}

