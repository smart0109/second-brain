// ── Speech Recognition ──
function initCopilotSpeech(){
  const SR=window.SpeechRecognition||window.webkitSpeechRecognition;
  if(!SR){
    document.getElementById('btnListen').textContent='Mic Unavailable';
    document.getElementById('btnListen').disabled=true;
    document.getElementById('listenStatus').textContent='Speech recognition not supported in this viewer. Type or paste transcript below instead.';
    return;
  }
  copilotRecognition=new SR();
  copilotRecognition.continuous=true;
  copilotRecognition.interimResults=true;
  copilotRecognition.lang='en-US';
  copilotRecognition.maxAlternatives=1;

  copilotRecognition.onresult=(e)=>{
    let interim='';
    for(let i=e.resultIndex;i<e.results.length;i++){
      const t=e.results[i][0].transcript;
      if(e.results[i].isFinal){
        copilotTranscriptLines.push({text:t.trim(),time:new Date(),confidence:e.results[i][0].confidence});
        renderCopilotTranscript();
        checkObjections(t);
      } else { interim=t; }
    }
    if(interim) renderCopilotInterim(interim);
  };
  copilotRecognition.onerror=(e)=>{
    if(e.error==='not-allowed'){
      document.getElementById('listenStatus').textContent='Microphone blocked by embedded viewer. Type or paste transcript below instead.';
      document.getElementById('btnListen').textContent='Mic Blocked';
      document.getElementById('btnListen').disabled=true;
    } else if(e.error!=='no-speech'){
      document.getElementById('listenStatus').textContent='Error: '+e.error+'. Restarting...';
    }
  };
  copilotRecognition.onend=()=>{
    if(copilotListening){try{copilotRecognition.start()}catch(e){}}
  };
}

function toggleListening(){
  if(!copilotRecognition){initCopilotSpeech();if(!copilotRecognition)return;}
  if(copilotListening){
    copilotListening=false;
    try{copilotRecognition.stop()}catch(e){}
    document.getElementById('btnListen').textContent='Start Listening';
    document.getElementById('btnListen').className='listen-btn idle';
    document.getElementById('listenStatus').textContent='Stopped';
